{
  "name": "inkline",
  "version": "0.5.22",
  "description": "墨斗·Inkline — Sketch 标注 / 交付 / 素材插件（Kitchen + Sketch Measure 组合体）",
  "skpm": {
    "name": "墨斗·Inkline",
    "manifest": "src/manifest.json",
    "main": "inkline.sketchplugin",
    "assets": [
      "assets/icon.png",
      "assets/icon@2x.png"
    ]
  },
  "scripts": {
    "build": "skpm-build && rm -f inkline.sketchplugin/Contents/Sketch/*.map",
    "watch": "skpm-watch"
  },
  "devDependencies": {
    "@skpm/builder": "^1.0.0",
    "skpm": "^1.3.3"
  },
  "dependencies": {
    "@babel/runtime": "^7.29.10",
    "sketch-module-web-view": "^3.5.3"
  }
}
